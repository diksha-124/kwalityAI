                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div id="designation-group">
                                        <label for="desig">Designation</label>
                                        <input type="text" id="designation-input" class="form-control" readonly="readonly" />
                                    </div>

                                </div>
                                <div class="col-md-6">
                                    <div id="section-group">
                                        <label for="sect">Section</label>
                                        <input type="text" id="section-input" class="form-control" readonly />
                                    </div>

                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div id="department-group">
                                        <label for="dept">Department</label>
                                        <input type="text" id="department-input" class="form-control" readonly />
                                    </div>

                                </div>
                                <div class="col-md-6">
                                    <div id="date-time-group">
                                        <label for="date-time-input">Date</label>
                                        <input type="text" id="datetimeInput" class="form-control" readonly />
                                    </div>
                                </div>

                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div id="box-container" class="d-flex align-items-center justify-content-center">
                                        <canvas id="qrCodeContainer" width="100" height="100"></canvas>
                                    </div>
                                </div>
                                <div class="col-md-6 d-flex align-items-center justify-content-center">
                                    <button type="button" class="btn btn-primary w-100" id="saveI" title="Click for Data Save">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>















            </div>

        </div>


    </header>






    @*<h2>Log in or sign up</h2>
                    <p>You’ll get smarter responses and can upload files, images, and more..</p>

                    <button class="option-btn">
                        <img src="https://www.gstatic.com/images/branding/product/1x/gsa_64dp.png"
